# Environment file for opencloud-docserver (systemd)
# Place at /etc/opencloud-docserver/env  (chmod 600, owned by root)
DOCSERVER_PORT=8000
DOCSERVER_HOST=0.0.0.0
DOCSERVER_DATABASE=/opt/opencloud-docserver/data/docserver.db
DOCSERVER_CONTENT_DIR=/opt/opencloud-docserver/data/documents
DOCSERVER_PUBLIC_URL=http://localhost:8000
DOCSERVER_CORS_ORIGINS=*
# DO NOT COMMIT THIS — generate with: openssl rand -base64 48
DOCSERVER_JWT_SECRET=change-me-32-chars-minimum
